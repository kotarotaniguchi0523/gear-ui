# =============================================================================
# LLM provider selection / 利用するLLMプロバイダ
#   anthropic (default) | openai
# =============================================================================
LLM_PROVIDER=anthropic

# Optionally override the model for the selected provider.
# プロバイダ既定モデルを上書きしたい場合に指定（任意）
#   anthropic default: claude-sonnet-4-5
#   openai    default: gpt-4o
# LLM_MODEL=

# --- Anthropic (Claude) ------------------------------------------------------
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- OpenAI / OpenAI-compatible ---------------------------------------------
# Used when LLM_PROVIDER=openai.
# OPENAI_BASE_URL lets you target OpenAI-compatible providers
# (OpenRouter, Together, Groq, Ollama, Gemini OpenAI-compatible API, ...).
# OPENAI_BASE_URL を指定すると OpenAI 互換エンドポイントも利用できます。
OPENAI_API_KEY=
# OPENAI_BASE_URL=
