{
  "name": "gear-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Codex で画面UI定義書と HTML モックを2段パイプラインで生成する OSS ツール / Generate screen-UI specs and HTML mocks with a two-stage Codex pipeline.",
  "license": "Apache-2.0",
  "author": "kotarotaniguchi0523",
  "contributors": [
    "Kumaiu",
    "Lancetier Inc."
  ],
  "homepage": "https://github.com/kotarotaniguchi0523/gear-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kotarotaniguchi0523/gear-ui.git"
  },
  "bugs": {
    "url": "https://github.com/kotarotaniguchi0523/gear-ui/issues"
  },
  "keywords": [
    "ai",
    "codex",
    "ui-generation",
    "design-tokens",
    "hono",
    "tailwindcss",
    "llm",
    "prototyping"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "concurrently -n server,client \"tsx watch src/server/index.ts\" \"vite --host 0.0.0.0 --port 5173\"",
    "build": "vite build && tsc -p tsconfig.server.json && tsc-alias -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "lint": "eslint",
    "lint:actions": "go run github.com/sisaku-security/sisakulint/cmd/sisakulint@14af18f3928e5f53d4c6e9b492b3062fea12c941",
    "security:pmsec": "npx --yes pmsec --check --tool npm,pnpm && test \"$(pnpm config get minimum-release-age --location project)\" = \"1440\" && test \"$(pnpm config get trust-policy --location project)\" = \"no-downgrade\" && test \"$(pnpm config get block-exotic-subdeps --location project)\" = \"true\" && test \"$(pnpm config get strict-dep-builds --location project)\" = \"true\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.2.7",
    "@fontsource/noto-sans-jp": "^5.2.9",
    "@hono/node-server": "^1.19.6",
    "@openai/codex-sdk": "0.137.0",
    "better-sqlite3": "^12.10.0",
    "hono": "^4.10.7",
    "lucide-static": "^0.547.0",
    "xstate": "^5.32.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "lefthook": "^2.0.0",
    "tailwindcss": "^4",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.21.0",
    "typescript": "^6",
    "typescript-eslint": "^8.49.0",
    "vite": "^7.2.7",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
